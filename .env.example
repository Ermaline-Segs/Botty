# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: register the /country slash command in one guild instantly
# (leave empty to register globally, which can take up to an hour to propagate)
GUILD_ID=

# Optional: REST Countries v5 API key (free at https://restcountries.com/sign-up)
# Without it the bot falls back to a public demo key that returns sample data.
REST_COUNTRIES_API_KEY=